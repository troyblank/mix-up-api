# Supabase → Project Settings → Database → Connection string (URI).
DATABASE_URL=

# Confluent Cloud (Kafka) — optional until you want delete events published.
# Bootstrap: Confluent Cloud → your cluster → Cluster settings → Bootstrap server.
KAFKA_BOOTSTRAP_SERVER=
KAFKA_TOPIC=
# Confluent cluster API key + secret (same values you’d pass as SASL username / password).
KAFKA_KEY=
KAFKA_SECRET=
